syntax "dots" "\.(dotS|vit)$"
comment "# "
color brightcyan "\<(space|pull|form|proc|give|begin|end)\>"
color brightblue "\<(module|use|import|fn|set|let|const|call|ret)\>"
color brightmagenta "\<(if|elif|else|loop|while|for|break|continue|try|catch|throw|as|and|or|not|in|case)\>"
color brightyellow "\<(true|false|null|int|i32|i64|f64|bool|string|bytes|ptr|result|void|any)\>"
color brightgreen "\"(\\.|[^\"])*\""
color brightred "\$[A-Za-z_][A-Za-z0-9_]*"
color brightwhite "\<[0-9]+\>"
color brightblack "#.*$"
color cyan "\<([A-Za-z_][A-Za-z0-9_]*\.)+[A-Za-z_][A-Za-z0-9_]*\>"
