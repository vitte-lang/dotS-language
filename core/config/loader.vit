    key: string
) -> string {
    if key == CONFIG_KEY_MODE {
        give "--mode";
    }

    if key == CONFIG_KEY_ENTRY {
        give "--entry";
    }

    if key == CONFIG_KEY_CORE {
        give "--core";
    }

    if key == CONFIG_KEY_STDLIB {
        give "--stdlib";
    }

    if key == CONFIG_KEY_MODULES {
        give "--modules";
    }

    if key == CONFIG_KEY_DEBUG {
        give "--debug";
    }

    if key == CONFIG_KEY_RECOVER_ERRORS {
        give "--recover-errors";
    }

    if key == CONFIG_KEY_ALLOW_IO {
        give "--allow-io";
    }

    if key == CONFIG_KEY_ALLOW_IMPORTS {
        give "--allow-imports";
    }

    if key == CONFIG_KEY_ALLOW_ENVIRONMENT {
        give "--allow-environment";
    }

    if key == CONFIG_KEY_MAX_SOURCE_SIZE {
        give "--max-source-size";
    }

    if key == CONFIG_KEY_MAX_TOKEN_COUNT {
        give "--max-token-count";
    }

    if key == CONFIG_KEY_MAX_PARSE_DEPTH {
        give "--max-parse-depth";
    }

    if key == CONFIG_KEY_MAX_CALL_DEPTH {
        give "--max-call-depth";
    }

    if key == CONFIG_KEY_MAX_LOOP_ITERATIONS {
        give "--max-loop-iterations";
    }

    if key == CONFIG_KEY_MAX_CONTAINER_SIZE {
        give "--max-container-size";
    }

    if key == CONFIG_KEY_MAX_STRING_SIZE {
        give "--max-string-size";
    }

    give "";
}

proc config_source_priority(
    kind: ConfigSourceKind
) -> usize {
    match kind {
        case ConfigSourceKind.Defaults => give 0;
        case ConfigSourceKind.File => give 100;
        case ConfigSourceKind.Environment => give 200;
        case ConfigSourceKind.CommandLine => give 300;
        case ConfigSourceKind.Programmatic => give 400;
    };
}

proc source_overrides(
    current: &ConfigSource,
    incoming: &ConfigSource
) -> bool {
    give incoming.priority >= current.priority;
}

proc loader_options_valid(
    options: &ConfigLoaderOptions
) -> bool {
    if options.load_file and options.config_file == "" {
        give false;
    }

    give true;
}

proc validate_config_entry(
    entry: &ConfigEntry
) -> ConfigLoadStatus {
    if entry.key == "" {
        give ConfigLoadStatus.InvalidKey;
    }

    let mut index: usize = 0;

    while index < entry.key.length {
        if not is_config_key_character(entry.key[index]) {
            give ConfigLoadStatus.InvalidKey;
        }

        set index += 1;
    }

    let kind: ?ConfigValueKind =
        expected_value_kind(entry.key);

    if kind == null {
        give ConfigLoadStatus.InvalidKey;
    }

    match kind {
        case ConfigValueKind.Boolean => {
            if parse_boolean(entry.value) == null {
                give ConfigLoadStatus.InvalidValue;
            }
        }

        case ConfigValueKind.Integer => {
            let value: ?usize = parse_usize(entry.value);

            if value == null {
                give ConfigLoadStatus.InvalidValue;
            }

            if value == 0 {
                give ConfigLoadStatus.InvalidValue;
            }
        }

        case ConfigValueKind.String => {
            if entry.value == "" {
                give ConfigLoadStatus.InvalidValue;
            }
        }
    };

    give ConfigLoadStatus.Ok;
}

proc load(
    options: &ConfigLoaderOptions
) -> LoadedConfig {
    assert loader_options_valid(options),
        "invalid DotS configuration loader options";

    let mut loaded: LoadedConfig =
        load_defaults(options);

    let status: ConfigLoadStatus =
        finalize_loaded_config(&mut loaded);

    if status != ConfigLoadStatus.Ok {
        set loaded.report.status = status;
    }

    give loaded;
}