space dots.core.config

export *

const DOTS_NAME: string = "DotS";
const DOTS_VERSION: string = "0.1.0";
const DOTS_EXTENSION: string = ".dots";

const DEFAULT_ENTRY_FILE: string = "main.dots";
const DEFAULT_ENCODING: string = "UTF-8";

const DEFAULT_CORE_PATH: string = "core";
const DEFAULT_STDLIB_PATH: string = "stdlib";
const DEFAULT_MODULE_PATH: string = "modules";

const DEFAULT_MAX_SOURCE_SIZE: usize = 16777216;
const DEFAULT_MAX_TOKEN_COUNT: usize = 1000000;
const DEFAULT_MAX_PARSE_DEPTH: usize = 512;

const DEFAULT_MAX_CALL_DEPTH: usize = 1024;
const DEFAULT_MAX_LOOP_ITERATIONS: usize = 10000000;
const DEFAULT_MAX_CONTAINER_SIZE: usize = 1000000;
const DEFAULT_MAX_STRING_SIZE: usize = 16777216;

pick DiagnosticLevel {
    Error,
    Warning,
    Info,
    Debug,
    Trace,
}

pick RuntimeMode {
    Script,
    Repl,
    Module,
    Test,
}

pick ErrorPolicy {
    Stop,
    Throw,
    Continue,
}

form LexerConfig {
    pub preserve_comments: bool,
    pub preserve_whitespace: bool,
    pub allow_block_comments: bool,
    pub allow_unicode: bool,
    pub max_source_size: usize,
    pub max_token_count: usize,
}

form ParserConfig {
    pub max_depth: usize,
    pub recover_errors: bool,
    pub allow_trailing_separator: bool,
}

form RuntimeConfig {
    pub mode: RuntimeMode,
    pub error_policy: ErrorPolicy,

    pub max_call_depth: usize,
    pub max_loop_iterations: usize,
    pub max_container_size: usize,
    pub max_string_size: usize,

    pub allow_io: bool,
    pub allow_imports: bool,
    pub allow_environment: bool,
}

form DiagnosticConfig {
    pub level: DiagnosticLevel,

    pub enabled: bool,
    pub show_source: bool,
    pub show_line: bool,
    pub show_column: bool,
    pub show_module: bool,
    pub show_stacktrace: bool,
}

form PathConfig {
    pub core: string,
    pub stdlib: string,
    pub modules: string,
    pub entry: string,
}

form DotSConfig {
    pub lexer: LexerConfig,
    pub parser: ParserConfig,
    pub runtime: RuntimeConfig,
    pub diagnostics: DiagnosticConfig,
    pub paths: PathConfig,
}

proc default_lexer_config() -> LexerConfig {
    give LexerConfig {
        preserve_comments: false,
        preserve_whitespace: false,
        allow_block_comments: true,
        allow_unicode: true,
        max_source_size: DEFAULT_MAX_SOURCE_SIZE,
        max_token_count: DEFAULT_MAX_TOKEN_COUNT,
    };
}

proc default_parser_config() -> ParserConfig {
    give ParserConfig {
        max_depth: DEFAULT_MAX_PARSE_DEPTH,
        recover_errors: true,
        allow_trailing_separator: true,
    };
}

proc default_runtime_config() -> RuntimeConfig {
    give RuntimeConfig {
        mode: RuntimeMode.Script,
        error_policy: ErrorPolicy.Stop,

        max_call_depth: DEFAULT_MAX_CALL_DEPTH,
        max_loop_iterations: DEFAULT_MAX_LOOP_ITERATIONS,
        max_container_size: DEFAULT_MAX_CONTAINER_SIZE,
        max_string_size: DEFAULT_MAX_STRING_SIZE,

        allow_io: true,
        allow_imports: true,
        allow_environment: false,
    };
}

proc default_diagnostic_config() -> DiagnosticConfig {
    give DiagnosticConfig {
        level: DiagnosticLevel.Error,

        enabled: true,
        show_source: true,
        show_line: true,
        show_column: true,
        show_module: true,
        show_stacktrace: true,
    };
}

proc default_path_config() -> PathConfig {
    give PathConfig {
        core: DEFAULT_CORE_PATH,
        stdlib: DEFAULT_STDLIB_PATH,
        modules: DEFAULT_MODULE_PATH,
        entry: DEFAULT_ENTRY_FILE,
    };
}

proc default_config() -> DotSConfig {
    give DotSConfig {
        lexer: default_lexer_config(),
        parser: default_parser_config(),
        runtime: default_runtime_config(),
        diagnostics: default_diagnostic_config(),
        paths: default_path_config(),
    };
}

proc repl_config() -> DotSConfig {
    let mut config: DotSConfig = default_config();

    set config.runtime.mode = RuntimeMode.Repl;
    set config.runtime.error_policy = ErrorPolicy.Continue;

    set config.parser.recover_errors = true;

    set config.diagnostics.level = DiagnosticLevel.Info;
    set config.diagnostics.show_stacktrace = false;

    give config;
}

proc test_config() -> DotSConfig {
    let mut config: DotSConfig = default_config();

    set config.runtime.mode = RuntimeMode.Test;
    set config.runtime.error_policy = ErrorPolicy.Stop;

    set config.diagnostics.level = DiagnosticLevel.Debug;
    set config.diagnostics.show_stacktrace = true;

    give config;
}

proc validate_lexer_config(config: &LexerConfig) -> bool {
    if config.max_source_size == 0 {
        give false;
    }

    if config.max_token_count == 0 {
        give false;
    }

    give true;
}

proc validate_parser_config(config: &ParserConfig) -> bool {
    if config.max_depth == 0 {
        give false;
    }

    give true;
}

proc validate_runtime_config(config: &RuntimeConfig) -> bool {
    if config.max_call_depth == 0 {
        give false;
    }

    if config.max_loop_iterations == 0 {
        give false;
    }

    if config.max_container_size == 0 {
        give false;
    }

    if config.max_string_size == 0 {
        give false;
    }

    give true;
}

proc validate_config(config: &DotSConfig) -> bool {
    if not validate_lexer_config(&config.lexer) {
        give false;
    }

    if not validate_parser_config(&config.parser) {
        give false;
    }

    if not validate_runtime_config(&config.runtime) {
        give false;
    }

    give true;
}